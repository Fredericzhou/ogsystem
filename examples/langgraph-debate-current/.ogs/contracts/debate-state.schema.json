{
  "version": "1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["debate_round", "positions", "objections", "consensus_reached", "decision", "summary"],
  "properties": {
    "debate_round": { "type": "integer", "minimum": 0 },
    "positions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimalist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argument", "risks"],
          "properties": {
            "argument": { "type": "string" },
            "risks": { "type": "string" }
          }
        },
        "alignmentist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["argument", "alignment_areas"],
          "properties": {
            "argument": { "type": "string" },
            "alignment_areas": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "objections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary"],
        "properties": { "summary": { "type": "string" } }
      }
    },
    "consensus_reached": { "type": "boolean" },
    "decision": { "type": "string" },
    "summary": { "type": "string" }
  }
}
