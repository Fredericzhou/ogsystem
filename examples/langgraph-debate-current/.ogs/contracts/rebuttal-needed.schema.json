{
  "version": "1",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["consensus_reached", "objections"],
  "properties": {
    "consensus_reached": { "const": false },
    "objections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": { "summary": { "type": "string" } }
    }
  }
}
