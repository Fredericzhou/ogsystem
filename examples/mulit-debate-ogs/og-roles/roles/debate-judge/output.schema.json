{
  "type": "object",
  "required": ["event", "content", "data"],
  "properties": {
    "event": {
      "type": "string",
      "enum": ["REBUTTAL_NEEDED", "DECISION_READY"]
    },
    "content": { "type": "string" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "consensus_reached": { "type": "boolean" },
        "objections": {
          "type": "object",
          "additionalProperties": false,
          "required": ["summary"],
          "properties": { "summary": { "type": "string", "minLength": 1 } }
        },
        "decision": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "event": { "const": "REBUTTAL_NEEDED" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["consensus_reached", "objections"],
            "properties": { "consensus_reached": { "const": false } }
          }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "DECISION_READY" } } },
      "then": {
        "properties": {
          "data": {
            "type": "object",
            "required": ["consensus_reached", "decision"],
            "properties": { "consensus_reached": { "const": true } }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
