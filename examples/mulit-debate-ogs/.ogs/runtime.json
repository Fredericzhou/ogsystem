{
  "configVersion": "2",
  "executor": "opencode",
  "roleRepo": "./og-roles",
  "runsDir": ".ogs/runs",
  "workspace": {
    "rolesDir": "roles",
    "privateDirName": "private",
    "workspaceIsolation": "role"
  },
  "redaction": {
    "enabled": true
  },
  "opencode": {
    "baseArgs": [
      "run"
    ]
  },
  "runtime": {
    "error_flows": {
      "v1": false
    }
  }
}
