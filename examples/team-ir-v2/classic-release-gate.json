{
  "schemaVersion": 2,
  "team": { "id": "classic-release-gate", "version": "2.0.0" },
  "runInput": {
    "dataSchema": {
      "type": "object",
      "properties": { "request": { "type": "string", "minLength": 1 } },
      "required": ["request"],
      "additionalProperties": false
    },
    "preferencesSchema": { "type": "object", "additionalProperties": true },
    "artifactSlots": {}
  },
  "runResult": {
    "dataSchema": {
      "type": "object",
      "properties": {
        "decision": { "type": "string", "enum": ["PASS", "REJECT", "ABSTAIN"] },
        "summary": { "type": "string", "minLength": 1 }
      },
      "required": ["decision", "summary"],
      "additionalProperties": false
    },
    "artifactSlots": {}
  },
  "executionPolicy": { "resultMode": "required", "activeExecutionBudgetMs": 300000 },
  "agents": [
    {
      "id": "release-gate",
      "packageRef": "role:release-gate@1",
      "bindingRef": "binding:release-gate",
      "inputPorts": {
        "default": {
          "dataSchema": {
            "type": "object",
            "properties": { "request": { "type": "string", "minLength": 1 } },
            "required": ["request"],
            "additionalProperties": false
          }
        }
      },
      "outputPorts": {
        "GATE_DECISION": {
          "dataSchema": {
            "type": "object",
            "properties": {
              "decision": { "type": "string", "enum": ["PASS", "REJECT", "ABSTAIN"] },
              "summary": { "type": "string", "minLength": 1 }
            },
            "required": ["decision", "summary"],
            "additionalProperties": false
          }
        }
      }
    }
  ],
  "handoffs": [
    {
      "id": "run-to-gate",
      "from": { "kind": "run" },
      "to": { "kind": "agent", "agentId": "release-gate", "inputPort": "default" },
      "map": { "data": { "request": { "$ref": "$.run.input.request" } } },
      "when": { "priority": 0 },
      "delivery": { "deadlineMs": 180000 }
    },
    {
      "id": "gate-pass-result",
      "from": { "kind": "agent", "agentId": "release-gate", "outputPort": "GATE_DECISION" },
      "to": { "kind": "result" },
      "map": {
        "data": {
          "decision": { "$ref": "$.output.data.decision" },
          "summary": { "$ref": "$.output.data.summary" }
        }
      },
      "when": {
        "condition": { "op": "equals", "args": [{ "$ref": "$.output.data.decision" }, { "$literal": "PASS" }] },
        "priority": 0
      }
    },
    {
      "id": "gate-reject-result",
      "from": { "kind": "agent", "agentId": "release-gate", "outputPort": "GATE_DECISION" },
      "to": { "kind": "result" },
      "map": {
        "data": {
          "decision": { "$ref": "$.output.data.decision" },
          "summary": { "$ref": "$.output.data.summary" }
        }
      },
      "when": {
        "condition": { "op": "equals", "args": [{ "$ref": "$.output.data.decision" }, { "$literal": "REJECT" }] },
        "priority": 1
      }
    },
    {
      "id": "gate-abstain-result",
      "from": { "kind": "agent", "agentId": "release-gate", "outputPort": "GATE_DECISION" },
      "to": { "kind": "result" },
      "map": {
        "data": {
          "decision": { "$ref": "$.output.data.decision" },
          "summary": { "$ref": "$.output.data.summary" }
        }
      },
      "when": {
        "condition": { "op": "equals", "args": [{ "$ref": "$.output.data.decision" }, { "$literal": "ABSTAIN" }] },
        "priority": 2
      }
    }
  ],
  "orchestration": {
    "routes": [
      { "from": { "kind": "run" }, "mode": "exclusive_priority", "onNoMatch": "fail", "handoffIds": ["run-to-gate"] },
      { "from": { "kind": "agent", "agentId": "release-gate", "outputPort": "GATE_DECISION" }, "mode": "exclusive_priority", "onNoMatch": "finish", "handoffIds": ["gate-pass-result", "gate-reject-result", "gate-abstain-result"] }
    ],
    "joins": [],
    "loops": [],
    "reviews": []
  },
  "bindings": [
    {
      "id": "binding:release-gate",
      "kind": "model",
      "modelRef": "codex-gateway/gpt-6-luna",
      "attemptTimeoutMs": 120000,
      "retry": { "maxAttempts": 1, "retryOn": [], "backoff": { "mode": "none" } }
    }
  ]
}
