{
  "type": "object",
  "required": ["event", "content"],
  "properties": {
    "event": {
      "type": "string",
      "enum": ["COMPENSATED", "ESCALATED", "ABORTED"]
    },
    "content": { "type": "string" },
    "data": { "type": "object" }
  },
  "if": {
    "properties": { "event": { "const": "COMPENSATED" } },
    "required": ["event"]
  },
  "then": {
    "properties": {
      "data": {
        "type": "object",
        "required": ["compensation"],
        "properties": {
          "compensation": {
            "type": "object",
            "required": ["action", "verified"],
            "properties": {
              "action": { "type": "string", "minLength": 1 },
              "verified": { "const": true }
            }
          }
        }
      }
    },
    "required": ["data"]
  },
  "additionalProperties": false
}
