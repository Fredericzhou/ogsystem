{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogsystem.dev/schemas/model-catalog.schema.json",
  "title": "OGSystem Model Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "generatedAt", "sources", "models"],
  "properties": {
    "catalogVersion": { "const": "2" },
    "generatedAt": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["backend", "command", "status"],
        "properties": {
          "backend": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "status": { "enum": ["available", "unavailable"] },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["backend", "runnable", "modelId", "ref", "provider", "model", "capabilities", "variants"],
        "properties": {
          "backend": { "type": "string", "minLength": 1 },
          "runnable": { "type": "boolean" },
          "modelId": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": ["textInput", "textOutput", "toolcall"],
            "properties": {
              "textInput": { "type": "boolean" },
              "textOutput": { "type": "boolean" },
              "toolcall": { "type": "boolean" }
            }
          },
          "variants": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "raw": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "providerID": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
