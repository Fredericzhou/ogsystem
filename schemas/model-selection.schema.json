{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ogsystem.dev/schemas/model-selection.schema.json",
  "title": "OGSystem Model Selection",
  "type": "object",
  "additionalProperties": false,
  "required": ["configVersion"],
  "properties": {
    "configVersion": { "const": "2" },
    "defaults": { "$ref": "#/$defs/selection" },
    "roles": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/selection" }
    }
  },
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "modelId"],
      "properties": {
        "backend": { "enum": ["opencode", "codex", "claude", "antigravity"] },
        "modelId": { "type": "string", "minLength": 1 },
        "variant": { "type": "string", "minLength": 1 },
        "timeoutMs": { "type": "integer", "minimum": 1 },
        "maxOutputBytes": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
